# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# ─── OS ───
.DS_Store

# ─── Build-Artefakte des Gedächtnisses (nie einchecken) ───
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.bak.*
*.bak-*

# Metrics sind generierte Daten, kein Quellcode
examples/memory/metrics/*
!examples/memory/metrics/.gitkeep
metrics/

# correction_synapse: local snapshots of the assistant's file state -- never commit
**/inbox/.edit_snapshots/
**/inbox/.edit_state.json
*.jsonl
retrieval_config.json

# Generierte Register (von markmem-deadends erzeugt, kein Quellcode)
examples/memory/reference_deadends_registry.md
examples/memory/reference_sackgassen_registry.md

# ─── Privacy: echte Memory-Datenbanken NIE einchecken ───
# Nur synthetische *.sample.md + die Demo-Index-Dateien gehören ins Repo.
# Reale Notizen liegen außerhalb (per MARKMEM_MEMORY_DIR) und bleiben privat.
/memory/
/data/
*.private.md
